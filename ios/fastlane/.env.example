# Copy to ios/fastlane/.env (git-ignored) and fill in. fastlane loads it itself.

# App Store Connect API key (Users and Access > Integrations > App Store Connect API)
ASC_KEY_ID=
ASC_ISSUER_ID=
# Either a path to the downloaded AuthKey_XXXX.p8 ...
ASC_KEY_PATH=
# ... or its content, base64 encoded (handy for CI secrets)
ASC_KEY_CONTENT=

# App Review contact + demo server (never commit these)
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_EMAIL=
REVIEW_PHONE=
REVIEW_DEMO_SERVER_URL=
REVIEW_DEMO_USER=
REVIEW_DEMO_PASSWORD=